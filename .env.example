# Required: MongoDB connection string.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/swapture?retryWrites=true&w=majority"

# Optional alias used by the app when DATABASE_URL is not set.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/swapture?retryWrites=true&w=majority"

# Required for login/session JWT signing.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional (chat assistant for site menu).
OPENAI_API_KEY="<your-openai-api-key>"

# Optional (only if using Telegram notifications).
TELEGRAM_BOT_TOKEN="<your-telegram-bot-token>"
TELEGRAM_CHAT_ID="<your-telegram-chat-id>"
